CLAMP_CBIOPORTAL_IMAGE=clamp-cbioportal:local
CLAMP_STUDY_LOADER_IMAGE=clamp-study-loader:local
CLAMP_SESSION_SERVICE_IMAGE=clamp-session-service:local
CLAMP_MYSQL_IMAGE=clamp-mysql:local
CLAMP_MONGO_IMAGE=clamp-mongo:local
CLAMP_KEYCLOAK_IMAGE=clamp-keycloak:local
CLAMP_WEB_IMAGE=clamp-web:local

DB_MYSQL_DB_NAME=cbioportal
DB_MYSQL_USERNAME=cbio_user
DB_MYSQL_PASSWORD=CHANGE_ME
DB_MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_MYSQL_URL=jdbc:mysql://cbioportal-database:3306/cbioportal?useSSL=false&allowPublicKeyRetrieval=true

MONGO_ROOT_USERNAME=mongo_admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USERNAME=session_user
MONGO_APP_PASSWORD=CHANGE_ME

BIND_ADDRESS=127.0.0.1
DEV_BIND_ADDRESS=127.0.0.1
DEV_MYSQL_PORT=47000
DEV_CBIOPORTAL_PORT=48000
WEB_PORT=45000
STUDY_DATA_PATH=./studies/clamp_2026
CBIOPORTAL_JAVA_OPTS=-Xms1g -Xmx4g
IMPORT_JAVA_OPTS=-Xms1g -Xmx8g
SESSION_JAVA_HEAP=512m
CBIOPORTAL_STARTUP_TIMEOUT=600

CBIOPORTAL_MEMORY_LIMIT=6g
IMPORT_MEMORY_LIMIT=10g
MYSQL_MEMORY_LIMIT=4g
MONGO_MEMORY_LIMIT=2g
SESSION_MEMORY_LIMIT=1g
KEYCLOAK_MEMORY_LIMIT=2g
WEB_MEMORY_LIMIT=256m
HOST_UID=1000
HOST_GID=1000

# Authentication is false or saml. Run configure-auth.sh --local before using saml.
AUTH_MODE=false
AUTH_IDP_MODE=local
TRUSTED_TLS_PROXY=false
PUBLIC_BASE_URL=http://localhost:45000
SAML_REGISTRATION_ID=cbio-saml-idp
SAML_ENTITY_ID=clamp-cbioportal
SAML_IDP_ORIGIN=http://localhost:46000
SAML_ALLOW_NULL_ORIGIN=false
SESSION_SERVICE_INSTANCE=clamp_portal
KEYCLOAK_PORT=46000
KEYCLOAK_REALM=clamp
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
AUTH_TEST_USERNAME=testuser
AUTH_TEST_PASSWORD=

# Set an age recipient for encrypted private-data backups. Restore uses the identity file.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=

# Optional release settings. Images are never pushed unless release.sh --push is used.
IMAGE_REGISTRY=
