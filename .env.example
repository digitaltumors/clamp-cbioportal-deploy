COMPOSE_PROJECT_NAME=clamp-cbioportal

CBIOPORTAL_VERSION=6.4.1
SESSION_SERVICE_VERSION=0.6.4
MYSQL_VERSION=8.0
MONGO_VERSION=4.2
NGINX_VERSION=1.27-alpine
KEYCLOAK_VERSION=26.2.4

CLAMP_CBIOPORTAL_IMAGE=clamp-cbioportal:local
CLAMP_STUDY_LOADER_IMAGE=clamp-study-loader:local
CLAMP_WEB_IMAGE=clamp-web:local

DB_MYSQL_DB_NAME=cbioportal
DB_MYSQL_USERNAME=cbio_user
DB_MYSQL_PASSWORD=CHANGE_ME
DB_MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_MYSQL_URL=jdbc:mysql://cbioportal-database:3306/cbioportal?useSSL=false&allowPublicKeyRetrieval=true

WEB_PORT=8088
CBIOPORTAL_JAVA_OPTS=-Xms1g -Xmx4g
IMPORT_JAVA_OPTS=-Xms1g -Xmx8g
HOST_UID=1000
HOST_GID=1000

# Authentication is false or saml. Run configure-auth.sh --local before using saml.
AUTH_MODE=false
PUBLIC_BASE_URL=http://localhost:8088
SAML_REGISTRATION_ID=cbio-saml-idp
SAML_ENTITY_ID=clamp-cbioportal
SAML_IDP_ORIGIN=http://localhost:8081
SAML_ALLOW_NULL_ORIGIN=true
SESSION_SERVICE_INSTANCE=clamp_portal
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=clamp
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
AUTH_TEST_USERNAME=testuser
AUTH_TEST_PASSWORD=

# Optional release settings. Images are never pushed unless release.sh --push is used.
IMAGE_REGISTRY=
